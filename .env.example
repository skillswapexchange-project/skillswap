# Application Settings
DEBUG=true
# Required when DEBUG=false. Generate a persistent key; never commit the real .env file.
SECRET_KEY=your-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL Database Settings (Recommended)
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_supabase_database_password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Optional Alternative: Connection URI (if preferred over individual variables)
# DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
