# Required when DEBUG=false. Generate a persistent key; never commit the real .env file.
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Omit DATABASE_URL to use backend/django_backend/db.sqlite3.
# For PostgreSQL, use: postgresql://user:password@host:5432/skillswap
DATABASE_URL=
ACCESS_TOKEN_EXPIRE_MINUTES=30
